allow system_server self process execmem
allow system_server system_lib_file file execmod
allow system_server hal_cwb_service service_manager find
allow system_server hal_oplus_sensor_aidl_service service_manager find
allow system_server hal_cwb_hwservice hwservice_manager find
allow system_server oplus_hal_displaypanel_hwservice hwservice_manager find
allow system_server hal_graphics_composer_default binder { call transfer }
allow hal_graphics_composer_default system_server binder transfer
allow system_server hal_oplus_sensor_aidl_default binder { call transfer }
allow hal_oplus_sensor_aidl_default system_server binder transfer

# OP13 live inventory 2026-10-05: /sys/kernel/oplus_display is
# sysfs_graphics_ffl; aod_light_mode_set is oppo_log_sysfs;
# dim_alpha and dim_dc_alpha are alpha_sysfs. Rules follow existing types,
# not path prefixes, so other objects with those same types are also covered.
# No generic sysfs write, permissive domains, chmod, relabel, or root daemon.
# init needs open+write to clear fingerprint HBM after nyako_fod stops.
allow init sysfs_graphics_ffl dir { getattr open read search }
allow init sysfs_graphics_ffl file { getattr open read write }
allow init oppo_log_sysfs dir { getattr open read search }
allow init oppo_log_sysfs file { getattr open read write }
allow init alpha_sysfs dir { getattr open read search }
allow init alpha_sysfs file { getattr open read write }

# Framework display control and init actions defined in vendor rc files.
allow system_server sysfs_graphics_ffl dir { getattr open read search }
allow system_server sysfs_graphics_ffl file { getattr open read write }
allow system_server oppo_log_sysfs dir { getattr open read search }
allow system_server oppo_log_sysfs file { getattr open read write }
allow system_server alpha_sysfs dir { getattr open read search }
allow system_server alpha_sysfs file { getattr open read write }
allow vendor_init sysfs_graphics_ffl dir { getattr open read search }
allow vendor_init sysfs_graphics_ffl file { getattr open read write }
allow vendor_init oppo_log_sysfs dir { getattr open read search }
allow vendor_init oppo_log_sysfs file { getattr open read write }
allow vendor_init alpha_sysfs dir { getattr open read search }
allow vendor_init alpha_sysfs file { getattr open read write }

# The two actual display-service domains on this OriginOS port.
allow surfaceflinger sysfs_graphics_ffl dir { getattr open read search }
allow surfaceflinger sysfs_graphics_ffl file { getattr open read write }
allow surfaceflinger oppo_log_sysfs dir { getattr open read search }
allow surfaceflinger oppo_log_sysfs file { getattr open read write }
allow surfaceflinger alpha_sysfs dir { getattr open read search }
allow surfaceflinger alpha_sysfs file { getattr open read write }
allow hal_graphics_composer_default sysfs_graphics_ffl dir { getattr open read search }
allow hal_graphics_composer_default sysfs_graphics_ffl file { getattr open read write }
allow hal_graphics_composer_default oppo_log_sysfs dir { getattr open read search }
allow hal_graphics_composer_default oppo_log_sysfs file { getattr open read write }
allow hal_graphics_composer_default alpha_sysfs dir { getattr open read search }
allow hal_graphics_composer_default alpha_sysfs file { getattr open read write }

# Real post-reboot AVC: OnePlus fingerprint HAL cannot search oplus_display.
# Permit its existing HBM/display ABI; do not grant unrelated sysfs writes.
allow hal_fingerprint_oppo sysfs_graphics_ffl dir { getattr open read search }
allow hal_fingerprint_oppo sysfs_graphics_ffl file { getattr open read write }

# User-provided complete CIL grants, normalized/deduplicated 2026-10-05.
# Preserve exactly the requested permissions; property file write is NOT
# permission to set properties and does not add property_service set.
allow hal_fingerprint_oppo vendor_fingerprint_prop file { getattr open read map write }
allow hal_allocator_default vendor_file file getattr
allow hal_vcode_default system_prop file open
allow hal_vcode_default servicemanager binder transfer
allow hal_sectee_default system_prop file open
allow hal_sectee_default init_service_status_private_prop file open
allow hal_trust_default system_prop file open
allow hal_trust_default init_service_status_private_prop file read
allow hal_trust_default servicemanager binder call
allow hal_sectee_default system_file file read
allow hal_vcustom_default system_prop file open
allow hal_vcustom_default servicemanager binder transfer
allow hal_vdtf_default system_prop file open
allow vendor_hal_alarm_qti_default system_file file open
# User's init -> sysfs_graphics_ffl open/write/getattr is already included above.
